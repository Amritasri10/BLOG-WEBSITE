{
  "info": {
    "name": "Authors",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "blogId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Get All Authors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authors/all?page=1&limit=10&search=&isPagination=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authors",
                "all"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "isPagination",
                  "value": "true"
                }
              ]
            },
            "description": "Public"
          }
        },
        {
          "name": "Get Public Author Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authors/profile/{{authorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authors",
                "profile",
                "{{authorId}}"
              ],
              "query": []
            },
            "description": "Public"
          }
        }
      ]
    },
    {
      "name": "Author Dashboard",
      "item": [
        {
          "name": "Get Author Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authors/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authors",
                "dashboard"
              ],
              "query": []
            },
            "description": "Author or Admin"
          }
        },
        {
          "name": "Get Pending Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authors/pending-comments?page=1&limit=10&isPagination=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authors",
                "pending-comments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "isPagination",
                  "value": "true"
                }
              ]
            },
            "description": "Author or Admin"
          }
        }
      ]
    }
  ]
}