{
  "info": {
    "name": "Comments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "blogId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get Comments By Blog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/comments/{{blogId}}?page=1&limit=10&isPagination=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "comments",
            "{{blogId}}"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "isPagination",
              "value": "true"
            }
          ]
        },
        "description": "Public — approved comments"
      }
    },
    {
      "name": "Add Comment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/comments/{{blogId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "comments",
            "{{blogId}}"
          ],
          "query": []
        },
        "description": "Logged-in user",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Nice article!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update Comment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/comments/{{commentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "comments",
            "{{commentId}}"
          ],
          "query": []
        },
        "description": "Own comment only",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Updated comment\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete Comment",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/comments/{{commentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "comments",
            "{{commentId}}"
          ],
          "query": []
        },
        "description": "Own comment, blog author, or Admin"
      }
    },
    {
      "name": "Approve Comment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/comments/{{commentId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "comments",
            "{{commentId}}",
            "approve"
          ],
          "query": []
        },
        "description": "Blog author or Admin"
      }
    }
  ]
}