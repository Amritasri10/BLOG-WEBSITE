{
  "info": {
    "name": "Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "blogId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Register User (Reader)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ],
              "query": []
            },
            "description": "Public — role User",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"reader1\",\n  \"email\": \"reader1@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.authToken) {",
                  "  pm.environment.set(\"authToken\", json.data.authToken);",
                  "  pm.collectionVariables.set(\"authToken\", json.data.authToken);",
                  "}",
                  "if (json?.data?._id) {",
                  "  pm.environment.set(\"userId\", json.data._id);",
                  "  pm.collectionVariables.set(\"userId\", json.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-author",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register-author"
              ],
              "query": []
            },
            "description": "Public — role Author",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"author1\",\n  \"email\": \"author1@example.com\",\n  \"password\": \"Password@123\",\n  \"bio\": \"Writes about tech\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.authToken) {",
                  "  pm.environment.set(\"authToken\", json.data.authToken);",
                  "  pm.collectionVariables.set(\"authToken\", json.data.authToken);",
                  "}",
                  "if (json?.data?._id) {",
                  "  pm.environment.set(\"userId\", json.data._id);",
                  "  pm.collectionVariables.set(\"userId\", json.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (User / Author / Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Public — token authToken me save hota hai",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.authToken) {",
                  "  pm.environment.set(\"authToken\", json.data.authToken);",
                  "  pm.collectionVariables.set(\"authToken\", json.data.authToken);",
                  "}",
                  "if (json?.data?._id) {",
                  "  pm.environment.set(\"userId\", json.data._id);",
                  "  pm.collectionVariables.set(\"userId\", json.data._id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Protected Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "profile"
              ],
              "query": []
            },
            "description": "JWT required"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/update-profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "update-profile"
              ],
              "query": []
            },
            "description": "JWT required — username, bio, profilePic",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"reader1\",\n  \"bio\": \"Hello\",\n  \"profilePic\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/update-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "update-password"
              ],
              "query": []
            },
            "description": "JWT required",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Password@123\",\n  \"newPassword\": \"NewPassword@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Admin User Management",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users?page=1&limit=10&search=&role=User&isPagination=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "role",
                  "value": "User",
                  "disabled": true
                },
                {
                  "key": "isPagination",
                  "value": "true"
                }
              ]
            },
            "description": "Admin only — role filter: User | Author | Admin"
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "users",
                "{{userId}}"
              ],
              "query": []
            },
            "description": "Admin only"
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{userId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "users",
                "{{userId}}",
                "role"
              ],
              "query": []
            },
            "description": "Admin only — role: User | Author | Admin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "users",
                "{{userId}}"
              ],
              "query": []
            },
            "description": "Admin only — param name is :id"
          }
        }
      ]
    }
  ]
}