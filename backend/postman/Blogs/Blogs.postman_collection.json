{
  "info": {
    "name": "Blogs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "blogId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Get All Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/all-blogs?page=1&limit=10&search=&category={{categoryId}}&sortBy=recent&isPagination=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "all-blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "{{categoryId}}",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "recent"
                },
                {
                  "key": "isPagination",
                  "value": "true"
                }
              ]
            },
            "description": "Public — published blogs. sortBy: recent | oldest | popular"
          }
        },
        {
          "name": "Get Single Blog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/get-blog/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "get-blog",
                "{{blogId}}"
              ],
              "query": []
            },
            "description": "Public"
          }
        },
        {
          "name": "Get Author Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/author/{{authorId}}?page=1&limit=10&isPagination=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "author",
                "{{authorId}}"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "isPagination",
                  "value": "true"
                }
              ]
            },
            "description": "Public — author ki published blogs"
          }
        }
      ]
    },
    {
      "name": "Author",
      "item": [
        {
          "name": "Create Blog",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "create"
              ],
              "query": []
            },
            "description": "Author only — title, description, image required",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Blog\",\n  \"description\": \"Short summary\",\n  \"content\": \"<p>Full content</p>\",\n  \"image\": \"https://example.com/cover.jpg\",\n  \"category\": \"{{categoryId}}\",\n  \"tags\": [\n    \"tech\"\n  ],\n  \"isPublished\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get My Blogs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/my-blogs?page=1&limit=10&isPagination=true&isPublished=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "my-blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "isPagination",
                  "value": "true"
                },
                {
                  "key": "isPublished",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Author only — drafts bhi"
          }
        },
        {
          "name": "Toggle Publish",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/toggle-publish/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "toggle-publish",
                "{{blogId}}"
              ],
              "query": []
            },
            "description": "Author only"
          }
        }
      ]
    },
    {
      "name": "Author or Admin",
      "item": [
        {
          "name": "Update Blog",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/update/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "update",
                "{{blogId}}"
              ],
              "query": []
            },
            "description": "Owner author or Admin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"description\": \"Updated summary\",\n  \"content\": \"<p>Updated</p>\",\n  \"image\": \"https://example.com/cover.jpg\",\n  \"category\": \"{{categoryId}}\",\n  \"tags\": [\n    \"tech\"\n  ],\n  \"isPublished\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Blog",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/delete/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "delete",
                "{{blogId}}"
              ],
              "query": []
            },
            "description": "Owner author or Admin"
          }
        }
      ]
    },
    {
      "name": "Logged-in User",
      "item": [
        {
          "name": "Toggle Like",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/like/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "like",
                "{{blogId}}"
              ],
              "query": []
            },
            "description": ""
          }
        },
        {
          "name": "Toggle Save",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blogs/save/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blogs",
                "save",
                "{{blogId}}"
              ],
              "query": []
            },
            "description": ""
          }
        }
      ]
    }
  ]
}