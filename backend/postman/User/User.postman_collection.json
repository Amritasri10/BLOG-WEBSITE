{
  "info": {
    "name": "User",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "blogId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get Saved Blogs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/user/saved-blogs?page=1&limit=10&isPagination=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "user",
            "saved-blogs"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "isPagination",
              "value": "true"
            }
          ]
        },
        "description": "Logged-in user"
      }
    },
    {
      "name": "Get Liked Blogs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/user/liked-blogs?page=1&limit=10&isPagination=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "user",
            "liked-blogs"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "isPagination",
              "value": "true"
            }
          ]
        },
        "description": "Logged-in user"
      }
    },
    {
      "name": "Get Following Authors",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/user/following",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "user",
            "following"
          ],
          "query": []
        },
        "description": "Logged-in user"
      }
    },
    {
      "name": "Toggle Follow Author",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/user/follow/{{authorId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "user",
            "follow",
            "{{authorId}}"
          ],
          "query": []
        },
        "description": "Logged-in user — follow / unfollow"
      }
    }
  ]
}